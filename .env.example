# Internal service. Do not put real secrets in git.
# NAME_FILE mounts win over NAME (Docker Swarm / GCP secret files).

NODE_ENV=development
HOST=127.0.0.1
PORT=3600
LOG_LEVEL=info

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_ALLOWED_HOSTS=api.deepseek.com
LLM_ALLOWED_MODELS=deepseek-flash
# Swarm: LLM_API_KEY_FILE=/run/secrets/llm_api_key (external secret llm_api_key)
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1
LLM_TOTAL_BUDGET_MS=90000
# disabled is the normal/cheap default. enabled requires reasoning_content passback on later tool turns.
LLM_THINKING=disabled

CALLER_ISSUERS=proba-gateway
CALLER_SUBJECTS=gateway
GATEWAY_SERVICE_PUBLIC_KEY_FILE=/run/secrets/gateway_service_jwks

AUDIT_PUBLISHER=redis
AUDIT_STREAM=proba.audit.events
# Swarm: REDIS_URL_FILE=/run/secrets/redis_url (external secret redis_url)
AUDIT_CONTENT_ENABLED=true
AUDIT_CONTENT_MASK_PII=true
TURN_STORE_DIR=data/turns

# Optional unit prices (USD per 1M tokens). Omit to report cost.estimate=unknown.
# PRICE_PROMPT_USD_PER_MILLION is the cache-miss (full) input rate.
# PRICE_PROMPT_CACHE_HIT_USD_PER_MILLION is optional. When set and the provider
# returns cache hit/miss counts, those tokens are billed at the hit rate; otherwise
# every prompt token uses PRICE_PROMPT_USD_PER_MILLION.
# These are not defaulted. Official deepseek-flash list prices, verified 2026-11-14
# from https://api-docs.deepseek.com/quick_start/pricing/ (reference only, do not
# copy into env as a silent production activation):
#   peak     hit 0.006 / miss 0.30 / output 1.20
#   off-peak hit 0.003 / miss 0.15 / output 0.60
# Peak hours: 01:00-04:00 and 06:00-10:00 UTC, Mon-Fri excluding Chinese public holidays.
# PRICING_VERSION=
# PRICE_PROMPT_USD_PER_MILLION=
# PRICE_COMPLETION_USD_PER_MILLION=
# PRICE_PROMPT_CACHE_HIT_USD_PER_MILLION=

# Refused if true
# INGRESS_PUBLIC=false
